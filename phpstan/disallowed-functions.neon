parameters:
    # -----------------------------------------------------------------------
    # A2/A3/A4, B1-B4 and C3 of the rules ARCHITECTURE.md indexes, enforced at
    # the call site.
    #
    # `allowIn` paths are fnmatch patterns resolved against `filesRootDir`.
    # Every entry below carries a `message` naming the port to use instead:
    # the message is the whole rule as far as the next reader is concerned,
    # and "forbidden" without "use X" is a puzzle rather than an instruction.
    # -----------------------------------------------------------------------
    filesRootDir: %rootDir%/../../..

    disallowedFunctionCalls:
        # --- N1-R21: and not by curl, which predates every other spelling ---
        #
        # `curl_setopt($handle, CURLOPT_SSL_VERIFYPEER, false)` is the same
        # switch as an options array and is not one: it is a positional argument
        # to a function, so neither S3's array-item rule nor the method rule
        # above can see it. Refused at the function, because there is no call to
        # `curl_setopt` this application should be making at all — B3 already
        # says the network belongs to the SDK.
        -
            function:
                - 'curl_setopt()'
                - 'curl_setopt_array()'
                - 'stream_context_create()'
            message: "N1-R16 — every call to the API goes through the SDK, so this application does not open a connection of its own. It is also where certificate verification gets turned off without any other rule seeing it: CURLOPT_SSL_VERIFYPEER and an `ssl` stream context are both positional, so neither the array rule nor the method rule can read them (N1-R16, N1-R21)."

        # --- B1: time is an input, so it arrives through a port -------------
        -
            function:
                - 'now()'
                - 'time()'
                - 'date()'
                - 'mktime()'
                - 'microtime()'
                - 'hrtime()'
                - 'strtotime()'
                # The rest of the ways to read the clock. `new DateTimeImmutable()`
                # was already refused as a class; these are the function spellings
                # of the same act, and `date_create()` is the one that matters most
                # — it builds the object the class rule forbids, without naming it.
                - 'getdate()'
                - 'localtime()'
                - 'gettimeofday()'
                - 'idate()'
                - 'gmmktime()'
                - 'gmstrftime()'
                - 'date_create()'
                - 'date_create_immutable()'
            message: "B1 — time arrives through the Clock port. Time is a hidden input: the same call returns a different answer tomorrow, so no test can pin it. Inject Modules\\Kernel\\Api\\Clock and call $this->clock->now(). The one implementation that reads the device clock lives in app-modules/device/src (B1)."
            allowIn:
                - app-modules/device/src/*
                - tests/*
                - app-modules/*/tests/*
                - bridge/tests/*

        # --- B2: randomness is an input too --------------------------------
        -
            function:
                - 'random_int()'
                - 'random_bytes()'
                - 'rand()'
                - 'mt_rand()'
                - 'srand()'
                - 'mt_srand()'
                # Randomness that does not look like randomness. Each of these
                # draws from the global generator without the word `rand` being
                # anywhere near the call site, which is exactly why a reader — and
                # this list — skipped them.
                - 'shuffle()'
                - 'str_shuffle()'
                - 'array_rand()'
                - 'uniqid()'
            message: "B2 — randomness arrives through the Entropy port. Randomness is a hidden input. An idempotency key or a request id built from rand() cannot be asserted on, so the test asserts nothing. Inject Modules\\Kernel\\Api\\Entropy; its device-backed implementation lives in app-modules/device/src, and tests use the deterministic fake (B2)."
            allowIn:
                - app-modules/device/src/*
                - tests/*
                - app-modules/*/tests/*
                - bridge/tests/*

        # --- B4: waiting is a port, not a syscall ---------------------------
        -
            function:
                - 'sleep()'
                - 'usleep()'
                - 'time_nanosleep()'
                - 'time_sleep_until()'
            message: "B4 — waiting is a port, not a syscall. Sleeping blocks the one process that draws the screen, and a test that sleeps is a test that is slow and still flaky. Express \"retry after thirty seconds\" as a value on an Outcome and let the surface schedule it (B4)."

        # --- B3: the filesystem belongs to two adapters ---------------------
        -
            function:
                - 'file_get_contents()'
                - 'file_put_contents()'
                - 'fopen()'
                - 'fwrite()'
                - 'fread()'
                - 'fclose()'
                - 'unlink()'
                - 'mkdir()'
                - 'rmdir()'
                - 'rename()'
                - 'copy()'
                - 'file_exists()'
                - 'is_file()'
                - 'scandir()'
                - 'glob()'
                # Reading is reaching the filesystem as much as writing is, and
                # most of these read. `is_dir()` was on A9's list and not on this
                # one, which is the tell: the same call was work a provider may not
                # do and not filesystem access a module may not have.
                - 'file()'
                - 'readfile()'
                - 'fputs()'
                - 'fgets()'
                - 'fgetc()'
                - 'fgetcsv()'
                - 'fputcsv()'
                - 'touch()'
                - 'chmod()'
                - 'symlink()'
                - 'link()'
                - 'tempnam()'
                - 'tmpfile()'
                - 'opendir()'
                - 'readdir()'
                - 'closedir()'
                - 'is_dir()'
                - 'is_readable()'
                - 'is_writable()'
                - 'filesize()'
                - 'filemtime()'
                - 'realpath()'
            message: "B3 — the filesystem belongs to an adapter. It is IO, and IO is an adapter's job. A capability that reads a file cannot be unit tested and cannot be reasoned about offline. Use Modules\\Kernel\\Api\\SecureStore (implemented in app-modules/vault/src, on Keychain or Keystore) for anything that must survive a restart, or the device adapter for anything platform-owned (B3, N4-R5). `scripts/` is exempt for the same reason `tests/` is: a build step reads the repository it is building, which is not the hidden IO this rule is about."
            allowIn:
                - app-modules/vault/src/*
                - app-modules/device/src/*
                # The third adapter that owns a filesystem, and the narrowest of
                # the three: one directory holding one class. `modules/dx`
                # stands a stack in by reading the installed SDK's own
                # declarations — its envelopes and its endpoints — so it reads
                # files at runtime on the device as well as in a suite, and B3
                # is satisfied the way it asks to be: the IO is an adapter's and
                # nothing above it opens a file. A module-wide entry would have
                # been the easy answer and would have let a future stand-in do
                # hidden IO in `Api/`, which is the rule's actual worry.
                - app-modules/dx/src/Adapters/*
                - scripts/*
                - tests/*
                - app-modules/*/tests/*
                - bridge/tests/*

        # --- A3/A4: service location hides what a class needs ---------------
        -
            function:
                - 'app()'
                - 'resolve()'
                - 'config()'
                - 'cache()'
                - 'auth()'
                - 'request()'
                - 'session()'
                - 'session_start()'
                - 'logger()'
                - 'report()'
                - 'abort()'
                - 'event()'
                - 'dispatch()'
                # The rest of the container-reaching helpers, added because A4
                # said "container-reaching helpers" and named thirteen of them.
                # `view()` was the one that showed it: a screen called it, no
                # rule looked, and the sentence in ARCHITECTURE.md read as
                # though something had.
                - 'trans()'
                - 'trans_choice()'
                - '__()'
                - 'redirect()'
                - 'response()'
                - 'route()'
                - 'to_route()'
                - 'url()'
                - 'back()'
                - 'old()'
                - 'broadcast()'
                - 'validator()'
                - 'cookie()'
                - 'bcrypt()'
                - 'encrypt()'
                - 'decrypt()'
                - 'policy()'
                - 'gate()'
                - 'info()'
                - 'context()'
            message: "A3/A4 — dependencies arrive through the constructor. Reaching into the container makes the constructor stop telling the truth about what this class needs, and a reader has to run the code to find out. Declare the dependency as a constructor parameter and bind it in bootstrap/Composition (A3, A4)."
            allowIn:
                - bootstrap/Composition/*
                - config/*
                - tests/*
                - app-modules/*/tests/*
                - bridge/tests/*

        # --- A4: `view()`, where the framework owns the signature -----------
        #
        # Scoped rather than left off the list above, which is the difference
        # between an exception somebody can find and a rule that was never
        # written.
        #
        # A screen is a Livewire component and `render(): View` is the
        # framework's contract for one. Livewire instantiates a component
        # itself and hands dependencies to `mount()`, not to `__construct()`,
        # so there is no constructor for a view factory to arrive through —
        # injecting one is not a stricter version of this, it is a version that
        # does not resolve.
        #
        # Narrow on purpose. `Screens` is where a component's render method
        # lives; `view()` anywhere else is the service location A3 refuses, and
        # this entry does not reach it.
        -
            function:
                - 'view()'
            message: "A4 — `view()` reaches the container for a view factory. Inside a screen's render() it is the framework's own contract and is allowed; anywhere else, name the frame some other way. A class that reaches the container stops telling the truth about what it needs (A4)."
            allowIn:
                - app-modules/*/src/Internal/Screens/*
                # A Blade component's `render()` is the same contract as a
                # screen's, arrived at the same way: the framework builds the
                # object and asks it for a view. The directory is the one
                # `internachi/modular` registers components from, so this
                # reaches components and nothing else.
                - app-modules/*/src/View/Components/*
                # A trait the screens of both surfaces use, compiled into each
                # screen that uses it. Its `drawerOverride()` is the framework's
                # contract for a screen's drawer, asked for the way `render()`
                # is, so it names its frame the way a screen does.
                - app-modules/wayfinding/src/Api/Screens/*
                - bootstrap/Composition/*
                - config/*
                - tests/*
                - app-modules/*/tests/*
                - bridge/tests/*

        # --- S1: the execution bundle, scoped -------------------------------
        #
        # `passthru` is the execution bundle's, and the mutation runner's whole
        # job is to invoke Pest once per declared floor — a gate that runs a
        # tool, in the same category as the harness below.
        -
            function: 'passthru()'
            message: "S1 — nothing in this application runs a program. scripts/ is the exception: a build step invokes the tool it is a step for (S1)."
            allowIn:
                - scripts/*

        #
        # The rule-proving harness runs the analyser and the test suite as
        # subprocesses, which is the only way to observe whether a rule reports.
        # Scoped rather than ignored, so the ban holds everywhere else.
        -
            function: 'shell_exec()'
            message: "S1 — nothing in this application runs a program. There is no shell on a phone worth reaching for, and a string that reaches one is a string somebody can write into. Two exceptions, both of which exist to run other gates: the rule-proving harness in tests/Guards, which observes whether a rule reports by running the analyser and the suite as separate processes, and scripts/, which is where a build step invokes a tool (S1)."
            allowIn:
                - scripts/*
                - tests/Guards/*

        # --- Q1: the runtime is persistent, so a setting stays set ----------
        -
            function:
                - 'ini_set()'
                - 'ini_alter()'
                - 'error_reporting()'
                - 'set_error_handler()'
                - 'set_exception_handler()'
                - 'restore_error_handler()'
                - 'date_default_timezone_set()'
                - 'setlocale()'
                - 'set_time_limit()'
                - 'assert_options()'
                - 'ini_restore()'
                # Changing the encoding the `mb_` functions work in is changing
                # what every call to them means, from anywhere, for the rest of the
                # process. `L3` exists to put text through those functions; this is
                # the line that would quietly redefine them.
                - 'mb_internal_encoding()'
                - 'mb_regex_encoding()'
                - 'iconv_set_encoding()'
            message: "Q1 — the runtime is one long-lived process, so nothing resets. On a web server these calls last until the response ends; here Runtime::boot() runs once and every interaction after it inherits whatever the last screen changed. Configure it in config/ where the value is read once and is the same on every screen (Q1, I1)."
            allowIn:
                - config/*
                - tests/*
                - app-modules/*/tests/*
                - bridge/tests/*

        # --- P3: a class whose shape is a runtime question ------------------
        -
            function: 'func_get_args()'
            message: "P3 — a method's parameters are its signature. func_get_args() takes arguments the signature does not declare, so the analyser cannot check a call site and no rule here can see what is being passed. Declare the parameters, or take a typed collection (P3, D1)."

        # --- L3: bytes are not characters ------------------------------------
        -
            function:
                - 'strlen()'
                - 'substr()'
                - 'strtoupper()'
                - 'strtolower()'
                - 'ucfirst()'
                - 'lcfirst()'
                - 'str_pad()'
                - 'str_split()'
                - 'strpos()'
                - 'strrpos()'
                - 'wordwrap()'
                # The rest of the byte-indexed string functions that have an `mb_`
                # counterpart. `strrev()` is the plainest of them: it reverses
                # bytes, so a reversed UTF-8 string is not text at all.
                - 'strrev()'
                - 'ucwords()'
                - 'stripos()'
                - 'strripos()'
                - 'strstr()'
                - 'stristr()'
                - 'strrchr()'
                - 'substr_count()'
                - 'substr_replace()'
                - 'str_word_count()'
            message: "L3 — text a person reads is measured in characters, not bytes. This application ships en and nl and runs on a phone where names, stack labels and service titles carry accents: truncating one of those with substr() splits a character in half and renders a replacement glyph. Use the mb_* equivalent, which is what the multibyte extension is for (L3)."
            allowIn:
                - tests/*
                - app-modules/*/tests/*
                - bridge/tests/*

        # --- L4: a format string is one locale's answer ----------------------
        -
            function:
                - 'date_format()'
                - 'gmdate()'
                - 'strftime()'
            message: "L4 — a date is formatted for the reader, not written out by hand. A literal like 'd/m/Y' is wrong in one of the two locales before anyone leaves the country, and this application's whole subject is how long ago something was read. Prefer a duration, which needs no timezone and no calendar; where a date really must be shown, let the translator's formatter decide (L4)."
            allowIn:
                - tests/*
                - app-modules/*/tests/*
                - bridge/tests/*

        # --- L5: so is a decimal separator -----------------------------------
        -
            function:
                - 'number_format()'
                - 'money_format()'
            message: "L5 — Dutch writes 1.234,5 and English writes 1,234.5, so number_format() with separators written into the call is wrong in one locale by construction. Format through the translator, which knows which locale is on screen (L5)."
            allowIn:
                - tests/*
                - app-modules/*/tests/*
                - bridge/tests/*

        # --- L6: byte order is not alphabetical ------------------------------
        -
            function:
                - 'sort()'
                - 'rsort()'
                - 'strcmp()'
                - 'strcasecmp()'
                # Sorting values and keys is sorting. `sort()` and `rsort()` were
                # here and `asort()` was not, which meant the rule refused the
                # spelling that discards keys and allowed the one that keeps them —
                # and the one that keeps them is what a list of names actually uses.
                - 'asort()'
                - 'arsort()'
                - 'ksort()'
                - 'krsort()'
                - 'natsort()'
                - 'natcasesort()'
                - 'strncmp()'
                - 'strncasecmp()'
            message: "L6 — sorting text a person reads by byte order puts every accented character after z, so a service list reads as though it were shuffled. Compare with a collator for the locale on screen. Sorting values that are not text — a list of integers, an enum — is not this rule's business and belongs in a typed collection's own named operation anyway (L6, D1)."
            allowIn:
                - tests/*
                - app-modules/*/tests/*
                - bridge/tests/*
