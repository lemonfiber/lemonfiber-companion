{
    "name": "modules/operator",
    "description": "The operator surface: navigation and screen composition only.",
    "license": "LicenseRef-Hippocratic-3.0",
    "type": "library",
    "require": {
        "php": "^8.5",
        "modules/backups": "dev-main",
        "modules/connection": "dev-main",
        "modules/design": "dev-main",
        "modules/health": "dev-main",
        "modules/kernel": "dev-main",
        "modules/stacks": "dev-main",
        "modules/updates": "dev-main",
        "nativephp/mobile": "^4.4"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Operator\\": "src/",
            "Modules\\Operator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Operator\\Providers\\OperatorServiceProvider"
            ]
        },
        "lemonfiber": {
            "floors": {
                "coverage": 100,
                "mutation": 100
            },
            "kind": "surface"
        }
    }
}
