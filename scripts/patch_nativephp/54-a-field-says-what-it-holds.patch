+/// What the field holds, for the password manager; unknown or empty leaves it untyped.
+private func resolveContentType(_ kind: String) -> UITextContentType? {
+    switch kind {
+    case "username":     return .username
+    case "password":     return .password
+    case "new-password": return .newPassword
+    default:             return nil
+    }
+}
