+/** What the field holds, for the autofill service; unknown or empty leaves it untyped. */
+internal fun Modifier.nuiContentType(kind: String): Modifier {
+    val type = when (kind) {
+        "username" -> ContentType.Username
+        "password" -> ContentType.Password
+        "new-password" -> ContentType.NewPassword
+        else -> return this
+    }
+    return semantics { contentType = type }
+}
