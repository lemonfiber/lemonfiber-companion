+/// A text's font at the size it names where it is fixed, and scaled with the
+/// person's text size where it is not.
+private struct NUIFontAtItsSize: ViewModifier {
+    let fixed: Bool
+    let size: CGFloat
+    let weight: Font.Weight
+    let design: Font.Design
+    let fontName: String?
+    let italic: Bool
+
+    func body(content: Content) -> some View {
+        if fixed {
+            if let name = fontName, let custom = NativeUIFontResolver.font(name, size: size, italic: italic) {
+                content.font(custom.weight(weight))
+            } else {
+                content.font(.system(size: size, weight: weight, design: design))
+            }
+        } else {
+            content.nuiScaledFont(size: size, weight: weight, design: design, fontName: fontName, italic: italic)
+        }
+    }
+}
