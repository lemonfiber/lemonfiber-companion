<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutCoverageMetadata="false"
>
    <testsuites>
        <!-- The rules, first: a boundary break should fail before anything
             slower gets a chance to hide it. -->
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>

        <!-- Blade, which no analyser reads. -->
        <testsuite name="Templates">
            <directory>tests/Templates</directory>
        </testsuite>

        <!-- One suite per port, run against the real adapter and its fake. -->
        <testsuite name="Contract">
            <directory>tests/Contract</directory>
        </testsuite>

        <!-- Each module tests itself, next to itself. -->
        <testsuite name="Modules">
            <directory>app-modules/*/tests</directory>
        </testsuite>

        <!-- The composition root. -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
            <directory>app-modules/*/src</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
