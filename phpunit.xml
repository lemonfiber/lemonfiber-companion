<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnPhpunitDeprecation="true"
         failOnPhpunitNotice="true"
         failOnPhpunitWarning="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutCoverageMetadata="false"
>
    <!-- G11 — a diagnostic fails the run.
         The `failOn*` attributes above are one half of that, and on their own
         they are narrower than they read. A warning, notice or deprecation
         raised under `@` is dropped by PHPUnit's issue filter before it reaches
         the result, so the run prints it and still exits zero: the count in the
         summary and the exit code disagree, and only one of them is a gate.
         Most of what a framework raises at boot is raised under `@` — a missing
         file read with `@file_get_contents` is the common one — which makes
         that the class of diagnostic this repository is most likely to meet and
         least likely to fail on.
         The `ignoreSuppressionOf*` attributes on `<source>` below turn the
         suppression off for the result only. They report; they do not raise.
         `tests/Arch/TheSuiteCannotGoQuietTest.php` is what keeps both halves
         here, because either half alone is a gate that reads as one and is not.
    -->
    <testsuites>
        <!-- The rules, first: a boundary break should fail before anything
             slower gets a chance to hide it. R1 and R3 live here: the document
             and the codebase are checked against each other in both directions,
             and every architecture expectation is checked for the three shapes
             that read as a rule and check nothing. -->
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>

        <!-- Blade, which no analyser reads. -->
        <testsuite name="Templates">
            <directory>tests/Templates</directory>
        </testsuite>

        <!-- One suite per port, run against the real adapter and its fake. -->
        <testsuite name="Contract">
            <directory>tests/Contract</directory>
        </testsuite>

        <!-- Each module tests itself, next to itself. -->
        <testsuite name="Modules">
            <directory>app-modules/*/tests</directory>
        </testsuite>

        <!-- The native expansion's own PHP. A path package rather than a
             module, so the `app-modules/*/tests` pattern above does not reach
             it — and a package written here is not a package held to a lower
             bar. Its Kotlin and Swift are gated by their own jobs, which run
             only when those files change. -->
        <testsuite name="Native">
            <directory>native/tests</directory>
        </testsuite>

        <!-- The composition root. -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>

        <!-- Read from the clover report `composer test:report` writes, so this
             runs after it rather than inside `composer test`. It refuses to run
             without a report instead of skipping: a floors gate that passes
             when its input is missing passes in exactly the case where nobody
             measured anything. -->
        <testsuite name="Floors">
            <directory>tests/Floors</directory>
        </testsuite>

        <!-- R2, last and on its own: this plants a violation of every rule and
             runs the analyser and the suite over them as subprocesses. It is
             slow for a reason nothing can remove, and it must not run beside a
             suite that would see its fixtures. -->
        <testsuite name="Guards">
            <directory>tests/Guards</directory>
        </testsuite>
    </testsuites>

    <!-- G11, the other half. Each attribute names one kind of diagnostic that
         PHPUnit would otherwise discard for having been raised under `@`, and
         `restrictNotices` and `restrictWarnings` are left at their default of
         false so that a diagnostic raised inside a dependency still counts —
         our code is what asked for it. -->
    <source
        ignoreSuppressionOfDeprecations="true"
        ignoreSuppressionOfPhpDeprecations="true"
        ignoreSuppressionOfErrors="true"
        ignoreSuppressionOfNotices="true"
        ignoreSuppressionOfPhpNotices="true"
        ignoreSuppressionOfWarnings="true"
        ignoreSuppressionOfPhpWarnings="true"
    >
        <include>
            <directory>bootstrap/Composition</directory>
            <directory>app-modules/*/src</directory>
            <!--
                The plugin's own PHP. It is a path package rather than a module,
                so neither pattern above reaches it — and being a package is not
                a reason to be held to a lower bar than the code that calls it.
                Its Kotlin and Swift are gated separately, by the jobs that only
                run when those files change.
            -->
            <directory>native/src</directory>
        </include>
    </source>

    <!-- The whole environment a test runs in, and the only place it is written.
         `APP_ENV=testing` is load bearing beyond naming the environment: Laravel
         reads `.env.<APP_ENV>` where that file exists and `.env` where it does
         not, so it is what points the suite at the committed `.env.testing`
         instead of at whatever `.env` the machine happens to have. Delete that
         file and the suite reads a path that is not in the repository — a
         different environment per machine, and on a machine with no `.env` at
         all, a warning per booted test. G11 is what turns that into a failure. -->
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
