includes:
    # Larastan teaches the analyser the framework rather than lowering the bar.
    # Without it, level max cannot follow container resolution or Eloquent, and
    # the cost is paid in ignore comments — which is a baseline by another name.
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/ergebnis/phpstan-rules/rules.neon
    - vendor/tomasvotruba/type-coverage/config/extension.neon

parameters:
    level: max
    # Named so actions/cache can carry the result cache between runs.
    tmpDir: .phpstan-cache
    paths:
        - app
        - config
        - database
        - routes
        - tests
        - scripts

    # There is deliberately no `ignoreErrors` section and no baseline file.
    # A baseline is how strictness quietly dies: it converts today's failures
    # into tomorrow's silence, and nobody ever reads it again. If the analyser
    # is wrong, teach it with a stub; if it is right, fix the code.

    type_coverage:
        declare: 100
        return_type: 100
        param_type: 100
        property_type: 100
        constant_type: 100

    ergebnis:
        allRules: true
        noExtends:
            classesAllowedToBeExtended:
                - InvalidArgumentException
                - RuntimeException
                # NativePHP components are extended by the framework's own
                # contract; a component that did not extend it is not a screen.
                - Native\Mobile\Component
        # A screen's state is what the renderer reads on re-render, so a
        # component's properties are mutable by construction. Every other class
        # in this application is readonly, and an architecture test says so
        # rather than leaving the exemption to this file alone.
        noConstructorParameterWithDefaultValue:
            enabled: false
        noParameterWithNullDefaultValue:
            enabled: false
        # A nullable answer is the difference between "not read yet" and "read,
        # and there is nothing" — which is the distinction N1-R9 turns on.
        noParameterWithNullableTypeDeclaration:
            enabled: false
        noNullableReturnTypeDeclaration:
            enabled: false
