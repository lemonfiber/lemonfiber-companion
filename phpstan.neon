includes:
    # Larastan teaches the analyser the framework rather than lowering the bar.
    # Without it, level max cannot follow container resolution or Eloquent, and
    # the cost is paid in ignore comments — which is a baseline by another name.
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/ergebnis/phpstan-rules/rules.neon
    - vendor/tomasvotruba/type-coverage/config/extension.neon
    # Cognitive complexity, because SonarCloud measures it and a method that
    # trips Sonar in review should have tripped the analyser on a laptop first.
    - vendor/tomasvotruba/cognitive-complexity/config/extension.neon
    # The rules that make the A/B/C rules ARCHITECTURE.md indexes enforceable at
    # the call site rather than at the import, which is all an arch test can see.
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    # S1 — the four bundles the package already ships. Each is a list somebody
    # else maintains of calls that are dangerous, run something, are insecure by
    # construction, or leak through timing. Where one conflicts with this
    # codebase the conflict is scoped with `allowIn` in `phpstan/`, never
    # ignored: an ignore says the rule is wrong, and `allowIn` says where it
    # does not apply and leaves it in force everywhere else.
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-non-timing-safe-calls.neon
    - vendor/shipmonk/phpstan-rules/rules.neon
    # This repository's own refusals and rules, beside the parameters below:
    # the functions it refuses, the methods, names and structures it refuses,
    # and the rules written here.
    - phpstan/disallowed-functions.neon
    - phpstan/disallowed-methods-and-names.neon
    - phpstan/rules.neon

parameters:
    level: max
    # Named so actions/cache can carry the result cache between runs.
    tmpDir: .phpstan-cache
    paths:
        - bootstrap/Composition
        # Every module, src and tests alike. Written as the parent directory
        # rather than as `app-modules/*/src`: PHPStan does not expand globs in
        # `paths`, and naming each module would mean a module added tomorrow is
        # analysed only if somebody remembers to add a line here.
        - app-modules
        - config
        - routes
        # Build tooling is code too. It reads manifests and runs programs, which
        # is what two `allowIn` entries in `phpstan/disallowed-functions.neon`
        # are for — named, rather than a directory the analyser never looks at.
        - scripts
        - tests
        # The plugin's own PHP and its tests. It is a path package rather than a
        # module, so `app-modules` does not reach it and neither did this list —
        # while `phpunit.xml` holds `bridge/src` to the same coverage floor as
        # everything else and says in as many words that being a package is not
        # a reason to be held to a lower bar. `R4` is what keeps the two lists
        # saying the same thing.
        - bridge

    # A Blade template is a `.php` file by extension and is not PHP the
    # analyser can read: it is a tree of `native:` tags compiled by EDGE at
    # render time. Analysed, every one of them fails on a missing
    # `declare(strict_types=1)` — a declaration a template cannot carry.
    # `tests/Templates` is what reads these, over their text, which is the only
    # way anything can.
    excludePaths:
        - */resources/views/*.blade.php
        # Published by `native:install` rather than written here, and ignored by
        # git — so it is absent in CI and present on every machine that has run
        # a build. Analysed, the two disagree: a gate that answers differently
        # on two machines is read as noise, and then so is the next one.
        #
        # `(?)` marks it as a path that may not be there, and it is load-bearing
        # rather than tidy. Without it the analyser does not skip the file, it
        # refuses to start — and a bootstrap failure is not one red rule, it is
        # every rule reporting nothing. That takes `composer analyse` and the
        # guards suite down together, and the second of those fails saying the
        # analyser produced no readable output, which is the only reason the
        # cause is findable at all.
        - config/nativephp.php (?)

    # Pest's own annotation, corrected. See the stub for why.
    stubFiles:
        - phpstan/TestCall.stub


    # There is deliberately no `ignoreErrors` section and no baseline file.
    # A baseline is how strictness quietly dies: it converts today's failures
    # into tomorrow's silence, and nobody ever reads it again. If the analyser
    # is wrong, teach it with a stub; if a `disallowed-calls` rule is wrong,
    # scope it with `allowIn` so the exception is named and greppable.
    #
    # `reportUnmatchedIgnoredErrors` is on so that if anyone ever does add an
    # ignore, it dies the moment the code beneath it is fixed.
    reportUnmatchedIgnoredErrors: true

    # An uninitialized typed property is a null that the type system promised
    # was impossible. In a persistent runtime it survives the screen that
    # forgot to set it.
    checkUninitializedProperties: true
    # `mixed` arriving implicitly is still `mixed`. Without this, level max
    # accepts an untyped array element flowing into a typed parameter.
    checkImplicitMixed: true
    # PHPStan's benevolent unions are how `array_key_first()` and friends
    # quietly hand you the type you did not handle.
    checkBenevolentUnionTypes: true
    # A method that declares more than it returns makes every caller write a
    # branch for a case that cannot happen — C2's problem, one layer down.
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    # A `@var` that widens what the analyser already knew is a lie in a
    # comment, and comments are not checked by anything else.
    reportAnyTypeWideningInVarTag: true

    # D3 — no `mixed` in a public signature, and nothing untyped anywhere.
    type_coverage:
        declare: 100
        return_type: 100
        param_type: 100
        property_type: 100
        constant_type: 100

    # H3 — caps on size, and F1 — components stay thin.
    #
    # SonarCloud's default gate is 15 per function; these sit below it on
    # purpose, so the failure arrives here rather than in a review comment. A
    # NativePHP component holds state and delegates decisions, which means a
    # component needing thirty branches is a presenter in disguise.
    cognitive_complexity:
        class: 30
        function: 8

    # The one rule in `shipmonk/phpstan-rules` this repository configures, and
    # the only reason it needs configuring: `nativephp/mobile` 4.5.1 writes
    # only public, non-static properties from the client, where 4.4.1 wrote any
    # property that existed. A screen's state must therefore be public — and
    # public mutable state is what `enforceReadonlyPublicProperty` refuses, so
    # the framework's requirement and the rule cannot both hold unqualified.
    #
    # Excluding properties that carry a default is the narrowest switch the
    # rule offers and the right one to reach for: a public property with an
    # initialiser is state a component starts in, not a value somebody was
    # asked to pass in. Nothing is ignored and no baseline is written — the
    # rule stays on for every property without one.
    #
    # It is safe because `ModuleBoundariesTest` already requires every class in
    # a module that does not render to be readonly outright, so this can only
    # take effect inside a surface — which that test deliberately exempts, for
    # the reason it states there: only a surface holds state the renderer
    # re-reads. The architecture test remains the guard.
    shipmonkRules:
        enforceReadonlyPublicProperty:
            excludePropertyWithDefaultValue: true

    # `nativephp/mobile` 4.5.1 declares `@throws LockedPropertyException` on
    # `__syncProperty()`, which 4.4.1 did not. Every test that drives a screen
    # calls it and every Pest test body is a closure, so without this the
    # analyser reports a checked exception thrown inside a callable eleven
    # times over — about a refusal that cannot happen here.
    #
    # It cannot happen because the exception is thrown only for a property
    # carrying `#[Locked]`, and no screen has one. That is asserted rather than
    # assumed: `ScreensDeclarePaintingTest` goes red the day somebody locks a
    # property, which is the day this listing would stop being true.
    exceptions:
        uncheckedExceptionClasses:
            - Native\Mobile\Edge\Exceptions\LockedPropertyException
            # A frame that asked a stack what it serves is a frame whose one
            # reading is spent, and the reading it was drawing for waits for
            # the next. It crosses an adapter, a port and the screen that
            # asked, on purpose, to the one place every screen is drawn,
            # `WaitsAFrameForWhatTheStackServes`, which draws the waiting
            # frame. Declared at every port between, it would be a line on
            # every reading saying the same thing, and caught at any of them
            # it would be held as the screen's answer, which is the one thing
            # it must not be. `WaitsAFrameForWhatTheStackServesTest` is what
            # holds the one catch to drawing that frame.
            - Modules\Kernel\Api\TheReadingWaitsAFrame

    ergebnis:
        # `allRules` is where several documented rules actually live rather than
        # in an arch test: C4 (no `@` suppression) is NoErrorSuppressionRule and
        # the `switch` half of C5 is NoSwitchRule. Both were tried as Pest
        # expectations first and neither reported anything.
        allRules: true
        noExtends:
            classesAllowedToBeExtended:
                - InvalidArgumentException
                - RuntimeException
                # The parent of the first one, for the case it does not cover: a
                # call the design has no answer for, made with no argument at all.
                # `Session::__serialize()` is the example — there is no bad input
                # to name, only a caller asking for an operation that does not
                # exist (C3).
                - LogicException
                # The composition root is a Laravel service provider by
                # definition; there is no way to bind a port without being one.
                - Illuminate\Support\ServiceProvider
                # The navigation stack, whose one overridden method builds a
                # screen through the container instead of with `new`. Extending
                # is the only way in: `createComponent()` is protected, and the
                # closure that instantiates the router names its own class.
                - Native\Mobile\Edge\NativeRouter
                # Likewise the base test case: booting the application is the
                # whole reason Tests\TestCase exists.
                - Illuminate\Foundation\Testing\TestCase
                # A migration, which the migrator instantiates and runs: a
                # capability's table is created by one in its own
                # `database/migrations`, and there is no other way to be one.
                - Illuminate\Database\Migrations\Migration
                # The plugin's scanner builder, so a suite can run the scanner
                # adapter at all. `PendingScanner::scan()` reaches
                # `nativephp_call()`, which is a no-op off a handset — so the
                # adapter would register two callbacks and neither would ever
                # fire, and every assertion about what it does with an answer
                # would be about a callback nobody called. G1 refuses a mock of
                # a type we do not own; a subclass with the methods written out
                # fails to compile when the real class changes, which a mock
                # does not. Same reason ANotificationCentre extends the
                # notification plugin's own centre.
                - Native\Mobile\PendingScanner
                # NativePHP components are extended by the framework's own
                # contract; a component that did not extend it is not a screen.
                - Native\Mobile\Edge\NativeComponent
                # A native element a plugin adds to the tree, and the Blade tag
                # that draws it. The framework resolves a plugin's element by
                # its type and serialises it through the base class, so an
                # element that did not extend it would never reach the phone.
                - Native\Mobile\Edge\Element
                - Native\Mobile\Edge\Components\Native\NativeBladeComponent
                # A Blade component, for the reason a screen extends its own
                # base: the framework instantiates it and reads `render()` off
                # it. It is also what avoids the alternative — an anonymous
                # component, which Blade resolves by first guessing a class from
                # the application namespace, and guessing reads an `app/`
                # directory this repository does not have.
                - Illuminate\View\Component
                # The platform's secure store, extended once, in a test fake.
                # There is no Keychain behind a PHP process on a laptop, so
                # without a hand-written stand-in `PlatformKeychain` is a file
                # nothing executes — and the three things it decides (which key
                # a stack gets, which refusal a failure is, that forgetting
                # ignores the result) go unchecked until somebody holds a phone.
                # G1 asks for hand-written fakes rather than mocks, and this is
                # one: a subclass with the methods written out, which fails to
                # compile when the real class changes instead of drifting.
                - Native\Mobile\SecureStorage
                # The same argument for the local-notifications plugin. There is
                # no notification centre behind a PHP process on a laptop —
                # `requestPermission()` answers `null` wherever `nativephp_call()`
                # is absent — so without these two the adapter's whole delivery
                # path is a branch no test can reach.
                - NativePHP\LocalNotifications\LocalNotifications
                - NativePHP\LocalNotifications\ScheduledNotification
                # `PushNotifications::checkPermission()` reads the notification
                # permission without prompting, and reaches `nativephp_call()`
                # to do it — so off a handset it answers `null` and the three
                # standings that matter are unreachable. Push and local share
                # one OS permission on both platforms, which is why the push
                # facade is what a local notification's adapter reads.
                - Native\Mobile\PushNotifications
                # The network facade, for the same reason once more.
                # `Network::status()` answers `null` wherever `nativephp_call()`
                # is absent, which is every run of this suite — so the one thing
                # `PlatformNetwork` decides, that an absent bridge is not a
                # missing network, is a branch no test could otherwise enter,
                # and neither could the three malformed shapes it survives.
                - Native\Mobile\Network
        # A screen's state is what the renderer reads on re-render, so a
        # component's properties are mutable by construction. Every other class
        # in this application is readonly, and an architecture test says so
        # rather than leaving the exemption to this file alone.
        # A named argument at a call site is the only thing that tells a reader
        # which of four strings is the namespace. Refusing them makes a value
        # object's construction less readable, not safer.
        noNamedArgument:
            enabled: false
        noConstructorParameterWithDefaultValue:
            enabled: false
        noParameterWithNullDefaultValue:
            enabled: false
        # A nullable answer is the difference between "not read yet" and "read,
        # and there is nothing" — which is the distinction N1-R9 turns on.
        noParameterWithNullableTypeDeclaration:
            enabled: false
        noNullableReturnTypeDeclaration:
            enabled: false
