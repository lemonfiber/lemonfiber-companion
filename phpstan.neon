includes:
    # Larastan teaches the analyser the framework rather than lowering the bar.
    # Without it, level max cannot follow container resolution or Eloquent, and
    # the cost is paid in ignore comments — which is a baseline by another name.
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/ergebnis/phpstan-rules/rules.neon
    - vendor/tomasvotruba/type-coverage/config/extension.neon
    # Cognitive complexity, because SonarCloud measures it and a method that
    # trips Sonar in review should have tripped the analyser on a laptop first.
    - vendor/tomasvotruba/cognitive-complexity/config/extension.neon
    # The rules that make ARCHITECTURE.md's A/B/C sections enforceable at the
    # call site rather than at the import, which is all an arch test can see.
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    # S1 — the four bundles the package already ships. Each is a list somebody
    # else maintains of calls that are dangerous, run something, are insecure by
    # construction, or leak through timing. Where one conflicts with this
    # codebase the conflict is scoped with `allowIn` below, never ignored: an
    # ignore says the rule is wrong, and `allowIn` says where it does not apply
    # and leaves it in force everywhere else.
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-non-timing-safe-calls.neon
    - vendor/shipmonk/phpstan-rules/rules.neon

parameters:
    level: max
    # Named so actions/cache can carry the result cache between runs.
    tmpDir: .phpstan-cache
    paths:
        - app
        # Every module, src and tests alike. Written as the parent directory
        # rather than as `app-modules/*/src`: PHPStan does not expand globs in
        # `paths`, and naming each module would mean a module added tomorrow is
        # analysed only if somebody remembers to add a line here.
        - app-modules
        - config
        - routes
        # Build tooling is code too. It reads manifests and runs programs, which
        # is what the two `allowIn` entries below are for — named, rather than a
        # directory the analyser never looks at.
        - scripts
        - tests

    # A Blade template is a `.php` file by extension and is not PHP the
    # analyser can read: it is a tree of `native:` tags compiled by EDGE at
    # render time. Analysed, every one of them fails on a missing
    # `declare(strict_types=1)` — a declaration a template cannot carry.
    # `tests/Templates` is what reads these, over their text, which is the only
    # way anything can.
    excludePaths:
        - */resources/views/*.blade.php

    # Pest's own annotation, corrected. See the stub for why.
    stubFiles:
        - phpstan/TestCall.stub


    # There is deliberately no `ignoreErrors` section and no baseline file.
    # A baseline is how strictness quietly dies: it converts today's failures
    # into tomorrow's silence, and nobody ever reads it again. If the analyser
    # is wrong, teach it with a stub; if a `disallowed-calls` rule is wrong,
    # scope it with `allowIn` so the exception is named and greppable.
    #
    # `reportUnmatchedIgnoredErrors` is on so that if anyone ever does add an
    # ignore, it dies the moment the code beneath it is fixed.
    reportUnmatchedIgnoredErrors: true

    # An uninitialized typed property is a null that the type system promised
    # was impossible. In a persistent runtime it survives the screen that
    # forgot to set it.
    checkUninitializedProperties: true
    # `mixed` arriving implicitly is still `mixed`. Without this, level max
    # accepts an untyped array element flowing into a typed parameter.
    checkImplicitMixed: true
    # PHPStan's benevolent unions are how `array_key_first()` and friends
    # quietly hand you the type you did not handle.
    checkBenevolentUnionTypes: true
    # A method that declares more than it returns makes every caller write a
    # branch for a case that cannot happen — C2's problem, one layer down.
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    # A `@var` that widens what the analyser already knew is a lie in a
    # comment, and comments are not checked by anything else.
    reportAnyTypeWideningInVarTag: true

    # D3 — no `mixed` in a public signature, and nothing untyped anywhere.
    type_coverage:
        declare: 100
        return_type: 100
        param_type: 100
        property_type: 100
        constant_type: 100

    # H3 — caps on size, and F1 — components stay thin.
    #
    # SonarCloud's default gate is 15 per function; these sit below it on
    # purpose, so the failure arrives here rather than in a review comment. A
    # NativePHP component holds state and delegates decisions, which means a
    # component needing thirty branches is a presenter in disguise.
    cognitive_complexity:
        class: 30
        function: 8

    ergebnis:
        # `allRules` is where several documented rules actually live rather than
        # in an arch test: C4 (no `@` suppression) is NoErrorSuppressionRule and
        # the `switch` half of C5 is NoSwitchRule. Both were tried as Pest
        # expectations first and neither reported anything.
        allRules: true
        noExtends:
            classesAllowedToBeExtended:
                - InvalidArgumentException
                - RuntimeException
                # The parent of the first one, for the case it does not cover: a
                # call the design has no answer for, made with no argument at all.
                # `Session::__serialize()` is the example — there is no bad input
                # to name, only a caller asking for an operation that does not
                # exist (C3).
                - LogicException
                # The composition root is a Laravel service provider by
                # definition; there is no way to bind a port without being one.
                - Illuminate\Support\ServiceProvider
                # Likewise the base test case: booting the application is the
                # whole reason Tests\TestCase exists.
                - Illuminate\Foundation\Testing\TestCase
                # NativePHP components are extended by the framework's own
                # contract; a component that did not extend it is not a screen.
                - Native\Mobile\Edge\NativeComponent
                # The platform's secure store, extended once, in a test fake.
                # There is no Keychain behind a PHP process on a laptop, so
                # without a hand-written stand-in `PlatformKeychain` is a file
                # nothing executes — and the three things it decides (which key
                # a stack gets, which refusal a failure is, that forgetting
                # ignores the result) go unchecked until somebody holds a phone.
                # G1 asks for hand-written fakes rather than mocks, and this is
                # one: a subclass with the methods written out, which fails to
                # compile when the real class changes instead of drifting.
                - Native\Mobile\SecureStorage
        # A screen's state is what the renderer reads on re-render, so a
        # component's properties are mutable by construction. Every other class
        # in this application is readonly, and an architecture test says so
        # rather than leaving the exemption to this file alone.
        # A named argument at a call site is the only thing that tells a reader
        # which of four strings is the namespace. Refusing them makes a value
        # object's construction less readable, not safer.
        noNamedArgument:
            enabled: false
        noConstructorParameterWithDefaultValue:
            enabled: false
        noParameterWithNullDefaultValue:
            enabled: false
        # A nullable answer is the difference between "not read yet" and "read,
        # and there is nothing" — which is the distinction N1-R9 turns on.
        noParameterWithNullableTypeDeclaration:
            enabled: false
        noNullableReturnTypeDeclaration:
            enabled: false

    # -----------------------------------------------------------------------
    # ARCHITECTURE.md A2/A3/A4, B1-B4 and C3, enforced at the call site.
    #
    # `allowIn` paths are fnmatch patterns resolved against `filesRootDir`.
    # Every entry below carries a `message` naming the port to use instead:
    # the message is the whole rule as far as the next reader is concerned,
    # and "forbidden" without "use X" is a puzzle rather than an instruction.
    # -----------------------------------------------------------------------
    filesRootDir: %rootDir%/../../..

    disallowedFunctionCalls:
        # --- N1-R21: and not by curl, which predates every other spelling ---
        #
        # `curl_setopt($handle, CURLOPT_SSL_VERIFYPEER, false)` is the same
        # switch as an options array and is not one: it is a positional argument
        # to a function, so neither S3's array-item rule nor the method rule
        # above can see it. Refused at the function, because there is no call to
        # `curl_setopt` this application should be making at all — B3 already
        # says the network belongs to the SDK.
        -
            function:
                - 'curl_setopt()'
                - 'curl_setopt_array()'
                - 'stream_context_create()'
            message: "N1-R16 — every call to the API goes through the SDK, so this application does not open a connection of its own. It is also where certificate verification gets turned off without any other rule seeing it: CURLOPT_SSL_VERIFYPEER and an `ssl` stream context are both positional, so neither the array rule nor the method rule can read them (N1-R16, N1-R21)."

        # --- B1: time is an input, so it arrives through a port -------------
        -
            function:
                - 'now()'
                - 'time()'
                - 'date()'
                - 'mktime()'
                - 'microtime()'
                - 'hrtime()'
                - 'strtotime()'
            message: "B1 — time arrives through the Clock port. Time is a hidden input: the same call returns a different answer tomorrow, so no test can pin it. Inject Modules\\Kernel\\Api\\Clock and call $this->clock->now(). The one implementation that reads the device clock lives in app-modules/device/src (B1)."
            allowIn:
                - app-modules/device/src/*
                - tests/*
                - app-modules/*/tests/*

        # --- B2: randomness is an input too --------------------------------
        -
            function:
                - 'random_int()'
                - 'random_bytes()'
                - 'rand()'
                - 'mt_rand()'
                - 'srand()'
                - 'mt_srand()'
                - 'uniqid()'
            message: "B2 — randomness arrives through the Entropy port. Randomness is a hidden input. An idempotency key or a request id built from rand() cannot be asserted on, so the test asserts nothing. Inject Modules\\Kernel\\Api\\Entropy; its device-backed implementation lives in app-modules/device/src, and tests use the deterministic fake (B2)."
            allowIn:
                - app-modules/device/src/*
                - tests/*
                - app-modules/*/tests/*

        # --- B4: waiting is a port, not a syscall ---------------------------
        -
            function:
                - 'sleep()'
                - 'usleep()'
                - 'time_nanosleep()'
                - 'time_sleep_until()'
            message: "B4 — waiting is a port, not a syscall. Sleeping blocks the one process that draws the screen, and a test that sleeps is a test that is slow and still flaky. Express \"retry after thirty seconds\" as a value on an Outcome and let the surface schedule it (B4)."

        # --- B3: the filesystem belongs to two adapters ---------------------
        -
            function:
                - 'file_get_contents()'
                - 'file_put_contents()'
                - 'fopen()'
                - 'fwrite()'
                - 'fread()'
                - 'fclose()'
                - 'unlink()'
                - 'mkdir()'
                - 'rmdir()'
                - 'rename()'
                - 'copy()'
                - 'file_exists()'
                - 'is_file()'
                - 'scandir()'
                - 'glob()'
            message: "B3 — the filesystem belongs to an adapter. It is IO, and IO is an adapter's job. A capability that reads a file cannot be unit tested and cannot be reasoned about offline. Use Modules\\Kernel\\Api\\SecureStore (implemented in app-modules/vault/src, on Keychain or Keystore) for anything that must survive a restart, or the device adapter for anything platform-owned (B3, N4-R5). `scripts/` is exempt for the same reason `tests/` is: a build step reads the repository it is building, which is not the hidden IO this rule is about."
            allowIn:
                - app-modules/vault/src/*
                - app-modules/device/src/*
                - scripts/*
                - tests/*
                - app-modules/*/tests/*

        # --- A3/A4: service location hides what a class needs ---------------
        -
            function:
                - 'app()'
                - 'resolve()'
                - 'config()'
                - 'cache()'
                - 'auth()'
                - 'request()'
                - 'session()'
                - 'session_start()'
                - 'logger()'
                - 'report()'
                - 'abort()'
                - 'event()'
                - 'dispatch()'
            message: "A3/A4 — dependencies arrive through the constructor. Reaching into the container makes the constructor stop telling the truth about what this class needs, and a reader has to run the code to find out. Declare the dependency as a constructor parameter and bind it in app/Providers (A3, A4)."
            allowIn:
                - app/Providers/*
                - config/*
                - tests/*
                - app-modules/*/tests/*

        # --- S1: the execution bundle, scoped -------------------------------
        #
        # `passthru` is the execution bundle's, and the mutation runner's whole
        # job is to invoke Pest once per declared floor — a gate that runs a
        # tool, in the same category as the harness below.
        -
            function: 'passthru()'
            message: "S1 — nothing in this application runs a program. scripts/ is the exception: a build step invokes the tool it is a step for (S1)."
            allowIn:
                - scripts/*

        #
        # The rule-proving harness runs the analyser and the test suite as
        # subprocesses, which is the only way to observe whether a rule reports.
        # Scoped rather than ignored, so the ban holds everywhere else.
        -
            function: 'shell_exec()'
            message: "S1 — nothing in this application runs a program. There is no shell on a phone worth reaching for, and a string that reaches one is a string somebody can write into. Two exceptions, both of which exist to run other gates: the rule-proving harness in tests/Guards, which observes whether a rule reports by running the analyser and the suite as separate processes, and scripts/, which is where a build step invokes a tool (S1)."
            allowIn:
                - scripts/*
                - tests/Guards/*

        # --- Q1: the runtime is persistent, so a setting stays set ----------
        -
            function:
                - 'ini_set()'
                - 'ini_alter()'
                - 'error_reporting()'
                - 'set_error_handler()'
                - 'set_exception_handler()'
                - 'restore_error_handler()'
                - 'date_default_timezone_set()'
                - 'setlocale()'
                - 'set_time_limit()'
                - 'assert_options()'
            message: "Q1 — the runtime is one long-lived process, so nothing resets. On a web server these calls last until the response ends; here Runtime::boot() runs once and every interaction after it inherits whatever the last screen changed. Configure it in config/ where the value is read once and is the same on every screen (Q1, I1)."
            allowIn:
                - config/*
                - tests/*
                - app-modules/*/tests/*

        # --- P3: a class whose shape is a runtime question ------------------
        -
            function: 'func_get_args()'
            message: "P3 — a method's parameters are its signature. func_get_args() takes arguments the signature does not declare, so the analyser cannot check a call site and no rule here can see what is being passed. Declare the parameters, or take a typed collection (P3, D1)."

        # --- L3: bytes are not characters ------------------------------------
        -
            function:
                - 'strlen()'
                - 'substr()'
                - 'strtoupper()'
                - 'strtolower()'
                - 'ucfirst()'
                - 'lcfirst()'
                - 'str_pad()'
                - 'str_split()'
                - 'strpos()'
                - 'strrpos()'
                - 'wordwrap()'
            message: "L3 — text a person reads is measured in characters, not bytes. This application ships en and nl and runs on a phone where names, stack labels and service titles carry accents: truncating one of those with substr() splits a character in half and renders a replacement glyph. Use the mb_* equivalent, which is what the multibyte extension is for (L3)."
            allowIn:
                - tests/*
                - app-modules/*/tests/*

        # --- L4: a format string is one locale's answer ----------------------
        -
            function:
                - 'date_format()'
                - 'gmdate()'
                - 'strftime()'
            message: "L4 — a date is formatted for the reader, not written out by hand. A literal like 'd/m/Y' is wrong in one of the two locales before anyone leaves the country, and this application's whole subject is how long ago something was read. Prefer a duration, which needs no timezone and no calendar; where a date really must be shown, let the translator's formatter decide (L4)."
            allowIn:
                - tests/*
                - app-modules/*/tests/*

        # --- L5: so is a decimal separator -----------------------------------
        -
            function:
                - 'number_format()'
                - 'money_format()'
            message: "L5 — Dutch writes 1.234,5 and English writes 1,234.5, so number_format() with separators written into the call is wrong in one locale by construction. Format through the translator, which knows which locale is on screen (L5)."
            allowIn:
                - tests/*
                - app-modules/*/tests/*

        # --- L6: byte order is not alphabetical ------------------------------
        -
            function:
                - 'sort()'
                - 'rsort()'
                - 'strcmp()'
                - 'strcasecmp()'
            message: "L6 — sorting text a person reads by byte order puts every accented character after z, so a service list reads as though it were shuffled. Compare with a collator for the locale on screen. Sorting values that are not text — a list of integers, an enum — is not this rule's business and belongs in a typed collection's own named operation anyway (L6, D1)."
            allowIn:
                - tests/*
                - app-modules/*/tests/*

    disallowedStaticCalls:
        # --- B1 ------------------------------------------------------------
        -
            method:
                - 'Carbon\Carbon::now()'
                - 'Carbon\CarbonImmutable::now()'
                - 'Illuminate\Support\Carbon::now()'
                - 'Carbon\Carbon::today()'
                - 'Carbon\CarbonImmutable::today()'
            message: "B1 — time arrives through the Clock port. Carbon::now() reads a global clock, and freezing it in a test changes global state that the next test inherits. Inject Modules\\Kernel\\Api\\Clock and hand a FrozenClock to the test instead (B1)."
            allowIn:
                - app-modules/device/src/*
                - tests/*
                - app-modules/*/tests/*

        # --- B2 ------------------------------------------------------------
        -
            method:
                - 'Illuminate\Support\Str::random()'
                - 'Illuminate\Support\Str::uuid()'
                - 'Illuminate\Support\Str::orderedUuid()'
                - 'Illuminate\Support\Str::ulid()'
                - 'Ramsey\Uuid\Uuid::uuid4()'
                - 'Ramsey\Uuid\Uuid::uuid7()'
                - 'Symfony\Component\Uid\Uuid::v4()'
            message: "B2 — randomness arrives through the Entropy port. An id generated inline cannot be asserted on, and an IdempotencyKey that changes on every call is not an idempotency key. Inject Modules\\Kernel\\Api\\Entropy (B2)."
            allowIn:
                - app-modules/device/src/*
                - tests/*
                - app-modules/*/tests/*

        # --- N4-R11 -------------------------------------------------------
        #
        # `Dialog::alert()` is the one call that raises an alert of the app's
        # own: a modal the operator did not ask for, saying whatever the caller
        # passed. N4-R11 refuses exactly that — every notification originates in
        # the core's notification decisions, and `Notification` is the type that
        # carries one, holding a `Code` the server declared and no prose at all.
        #
        # Scoped to `alert()` on purpose. `toast()` is in-app feedback on an
        # action the operator just performed — "copied", "saved" — which is not
        # an alert and which the requirement is not about. A rule that took the
        # whole facade would be refusing a confirmation message under a
        # requirement about notifications, and a rule that overreaches is a rule
        # somebody switches off.
        -
            method:
                - 'Native\Mobile\Facades\Dialog::alert()'
            message: "N4-R11 — the app raises no alerts of its own. An alert here is a sentence this application wrote, shown to the operator as though the stack had said it. Every notification originates in the core's decisions: build a Modules\\Kernel\\Api\\Notification from the Code the server sent and let the translator supply the words (N4-R11, L1)."


    disallowedNamespaces:
        # --- A2: facades are global state wearing a class name --------------
        -
            class: 'Illuminate\Support\Facades\*'
            # Storage has its own entry below: it is banned for being IO, in
            # two more places than a facade is banned for being a facade.
            exclude: 'Illuminate\Support\Facades\Storage'
            message: "A2 — no facades. A facade is a global lookup that no constructor mentions and no test can substitute without touching global state. Type the contract (Illuminate\\Contracts\\*) as a constructor parameter and bind it in app/Providers, or — inside a module — define a port in Modules\\Kernel\\Api and keep Illuminate out entirely (A2, A7)."
            allowIn:
                - app/Providers/*
                - config/*
                # routes/console.php is Artisan's own registration file: the
                # facade there IS the composition, not a reach into one.
                - routes/*
                - tests/*
                - app-modules/*/tests/*

        # --- A8: the platform's facades are facades too ---------------------
        #
        # A2 covers Illuminate, and the module kinds permit `Native` in design
        # and surface modules — so this entry is what stops a screen calling
        # SecureStorage::get() directly, bypassing the vault adapter, its port
        # and every rule that makes a screen renderable off a device. The
        # package ships sixteen of these; SecureStorage is the sharp one,
        # because the session token lives there (N1-R23).
        -
            class: 'Native\Mobile\Facades\*'
            message: "A8 — the platform is reached through a port, not a facade. Native\\Mobile\\Facades\\* is a static global lookup exactly as an Illuminate facade is: no constructor mentions it, no test can substitute it without touching global state, and a screen that calls one cannot be rendered off a device. Define the capability as a port in Modules\\Kernel\\Api and implement it once — app-modules/device/src for anything the platform owns, app-modules/vault/src for anything that must survive a restart. SecureStorage in particular is where the session token lives, and reaching it from a screen bypasses the one adapter that is allowed to hold it (A8, A2, N1-R23, N4-R5)."
            allowIn:
                - app-modules/device/src/*
                - app-modules/vault/src/*
                - tests/*
                - app-modules/*/tests/*

        # --- B3: Storage is the filesystem with a nicer name ----------------
        -
            class: 'Illuminate\Support\Facades\Storage'
            message: "B3 — the filesystem belongs to an adapter. Storage writes to disk. Anything that must survive a restart on a phone belongs in the platform's secure storage via Modules\\Kernel\\Api\\SecureStore (app-modules/vault/src), never a file (N4-R5, B3)."
            allowIn:
                - app-modules/vault/src/*
                - app-modules/device/src/*
                - tests/*
                - app-modules/*/tests/*

        # --- P4: reflection is the analyser's blind spot ---------------------
        -
            class:
                - 'Reflection*'
                - 'ReflectionClass'
                - 'ReflectionMethod'
                - 'ReflectionProperty'
            message: "P4 — production code does not reflect. Every rule in this repository depends on the analyser being able to see what a class does, and reflection is where that stops: a member reached by name is a member no rule can find. The tests are the exception and use it deliberately — the boundary rules ask PHP directly precisely because the analyser cannot be asked (P4)."
            allowIn:
                - tests/*
                - app-modules/*/tests/*
                - phpstan/*

        # --- A3: the container, named directly ------------------------------
        -
            class:
                - 'Illuminate\Container\*'
                - 'Illuminate\Contracts\Container\Container'
            message: "A3 — no service location. A class that reaches into the container hides what it needs. The composition root in app/Providers is the one place that is allowed to know how a port meets an adapter (A3)."
            allowIn:
                - app/Providers/*
                - tests/*
                - app-modules/*/tests/*

        # --- B1: the clock, as a type ---------------------------------------
        -
            class:
                - 'DateTime'
                - 'DateTimeImmutable'
            # A signature may still name the type; it is constructing one out of
            # the ambient clock that is the problem.
            allowInParamTypes: true
            allowInReturnType: true
            allowInUse: true
            message: "B1 — time arrives through the Clock port. Constructing a DateTimeImmutable with no argument reads the system clock, which is the hidden input B1 exists to remove. Take an Instant from Modules\\Kernel\\Api\\Clock; the device adapter is the only place allowed to build one from the platform (B1)."
            allowIn:
                - app-modules/device/src/*
                - tests/*
                - app-modules/*/tests/*

    disallowedSuperglobals:
        # --- Q2: the runtime fills some of these in itself -------------------
        -
            superglobal:
                - '$_GET'
                - '$_POST'
                - '$_REQUEST'
                - '$_SERVER'
                - '$_ENV'
                - '$_COOKIE'
                - '$_SESSION'
                - '$_FILES'
                - '$GLOBALS'
            message: "Q2 — a module never reads a superglobal. This application answers nothing from the network, and the device runtime populates several of these itself while driving the application through the HTTP kernel — so what is in them describes the runtime's own plumbing rather than anything a screen should act on. $_ENV also routes around A5: configuration is read from config/, once (Q2, A5)."
            allowIn:
                - config/*
                - bootstrap/*
                - tests/*
                - app-modules/*/tests/*

    disallowedAttributes:
        # --- P3: a property that exists only at runtime -----------------------
        -
            attribute: 'AllowDynamicProperties'
            message: "P3 — a class's properties are declared. A dynamic property cannot be typed, cannot be found by any rule here, and turns a typo into a silent new field rather than an error (P3, A6)."

    disallowedControlStructures:
        # --- C5: `else`, which ergebnis's NoSwitchRule does not cover ---------
        -
            controlStructure:
                - 'else'
                - 'elseif'
            message: "C5 — no `else`. Return from the condition that refuses and let the rest of the method carry on at one indent, so each guard states the one thing it rules out and the happy path reads top to bottom. Where the branches are both answers rather than a refusal and a path, that is a `match`, which is exhaustive and returns a value (C5)."

    disallowedMethodCalls:
        # --- N1-R21: verification is not turned off by a call either --------
        #
        # S3's rule reads array items, which catches `['verify' => false]` in
        # every spelling an options array has. It cannot see a *call*, and the
        # framework ships one: `Http::withoutVerifying()` is a single fluent
        # method that does exactly what the array item does, reads as
        # deliberate, and would have passed every gate in this repository.
        #
        # No `allowIn`. N1-R21 says verification must not be disabled in any
        # build under any flag, and a test directory is a build — a fake that
        # turns verification off is a fake of something this app cannot do, and
        # the contract test that used it would be proving the wrong thing.
        -
            method:
                - 'Illuminate\Http\Client\PendingRequest::withoutVerifying()'
                - 'Illuminate\Http\Client\Factory::withoutVerifying()'
            message: "N1-R21 — certificate verification is not turned off, in any build, under any flag. ADR-0018 pins a stack by a fingerprint from the pairing material rather than by a public authority, so this does not relax a check: it removes the only one there is, and leaves the pin being compared by code nothing reaches. If a certificate is being refused, the fingerprint is the thing to look at (N1-R21, S3)."

        # --- C3: an exception that says nothing -----------------------------
        #
        # Matched on the constructor rather than on the class, so that naming
        # the type still works: a module-owned exception may extend one of
        # these, catch one, and name one in a signature. What it may not do is
        # throw one, which is the only part that reaches a caller.
        -
            method:
                - 'Exception::__construct()'
                - 'RuntimeException::__construct()'
                - 'LogicException::__construct()'
                - 'InvalidArgumentException::__construct()'
                - 'DomainException::__construct()'
                - 'UnexpectedValueException::__construct()'
                - 'ErrorException::__construct()'
            # Everywhere that is not a module. Written as an allow-list rather
            # than `allowExceptIn: [app-modules/*]` because `allowExceptIn`
            # short-circuits every directive evaluated after it.
            allowIn:
                - app/*
                - bootstrap/*
                - config/*
                - routes/*
                - tests/*
                - app-modules/*/tests/*
            # A module-owned exception constructing itself is the cure, not the
            # disease — and `new self(...)` inside a subclass of RuntimeException
            # resolves to the parent's constructor. Ordinary module code is not
            # a Throwable, so this widens nothing else.
            allowInInstanceOf:
                - 'Throwable'
            message: "C3 — every thrown exception is module-owned. A bare throw tells a catch block nothing it can act on, and a module boundary should be returning an Outcome rather than throwing at all (C1). Where a throw is genuinely right, name it: an exception class owned by the module says which module refused, and why (C3)."

services:
    # H5 — sprintf over concatenation and over interpolation. Two classes
    # because a PHPStan rule declares exactly one node type, one rule as far as
    # a reader is concerned: there is one way to build a string with a value in
    # it. Written here rather than found in a package because no published rule
    # set carries it, and the rule is small enough that owning it costs less
    # than the alternative of not having it.
    -
        class: Lemonfiber\Companion\PHPStan\Rules\PreferSprintfOverConcatRule
        tags:
            - phpstan.rules.rule
    -
        class: Lemonfiber\Companion\PHPStan\Rules\PreferSprintfOverInterpolationRule
        tags:
            - phpstan.rules.rule

    # D5 — no positional boolean literal at a call site.
    -
        class: Lemonfiber\Companion\PHPStan\Rules\NoPositionalBooleanArgumentRule
        tags:
            - phpstan.rules.rule

    # L1 — text a person reads comes from the translator. Scoped to the
    # directories a string passes through on its way to a screen, because that
    # is where the distinction between user-facing and developer-facing text
    # can be drawn from the path alone.
    -
        class: Lemonfiber\Companion\PHPStan\Rules\NoUserFacingLiteralRule
        tags:
            - phpstan.rules.rule

    # P1/P2 — what the analyser cannot see, it cannot govern. A magic method or
    # a dynamic name switches off every rule here for whatever it exposes.
    -
        class: Lemonfiber\Companion\PHPStan\Rules\NoMagicMethodRule
        tags:
            - phpstan.rules.rule
    -
        class: Lemonfiber\Companion\PHPStan\Rules\NoDynamicAccessRule
        tags:
            - phpstan.rules.rule

    # Q3/Q4 — the shapes that only make sense in a codebase this one is not:
    # late static binding with no subclass to find, and output with no stream
    # to write to.
    -
        class: Lemonfiber\Companion\PHPStan\Rules\NoLateStaticBindingRule
        tags:
            - phpstan.rules.rule
    -
        class: Lemonfiber\Companion\PHPStan\Rules\NoOutputRule
        tags:
            - phpstan.rules.rule

    # C6/C7/C8/C9 — absence, and the four ways it gets papered over.
    -
        class: Lemonfiber\Companion\PHPStan\Rules\NoBroadCatchRule
        tags:
            - phpstan.rules.rule
    -
        class: Lemonfiber\Companion\PHPStan\Rules\NoEmptyRule
        tags:
            - phpstan.rules.rule
    -
        class: Lemonfiber\Companion\PHPStan\Rules\NoNullsafeInDomainRule
        tags:
            - phpstan.rules.rule
    -
        class: Lemonfiber\Companion\PHPStan\Rules\NoNestedTernaryRule
        tags:
            - phpstan.rules.rule

    # D6 — a number in a method body has a name. SonarCloud reports this too,
    # which makes it a backstop rather than the gate: a rule that only fails in
    # review is a rule people meet after they have finished.
    -
        class: Lemonfiber\Companion\PHPStan\Rules\NoMagicNumberRule
        tags:
            - phpstan.rules.rule

    # S3 — certificate verification is never turned off. ADR-0018 pins a stack
    # by a fingerprint from the pairing material, and a verify-off switch leaves
    # the pin in place while making sure nothing ever reaches it.
    -
        class: Lemonfiber\Companion\PHPStan\Rules\NoWeakenedTlsRule
        tags:
            - phpstan.rules.rule

    # A9 — a service provider binds and does not work. Twelve module providers
    # run before the first frame; N1-R36 wants that frame usable without waiting
    # on a read.
    -
        class: Lemonfiber\Companion\PHPStan\Rules\ServiceProviderBindsOnlyRule
        tags:
            - phpstan.rules.rule
