includes:
    # Larastan teaches the analyser the framework rather than lowering the bar.
    # Without it, level max cannot follow container resolution or Eloquent, and
    # the cost is paid in ignore comments — which is a baseline by another name.
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/ergebnis/phpstan-rules/rules.neon
    - vendor/tomasvotruba/type-coverage/config/extension.neon
    # Cognitive complexity, because SonarCloud measures it and a method that
    # trips Sonar in review should have tripped the analyser on a laptop first.
    - vendor/tomasvotruba/cognitive-complexity/config/extension.neon
    # The rules that make ARCHITECTURE.md's A/B/C sections enforceable at the
    # call site rather than at the import, which is all an arch test can see.
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - vendor/shipmonk/phpstan-rules/rules.neon

parameters:
    level: max
    # Named so actions/cache can carry the result cache between runs.
    tmpDir: .phpstan-cache
    paths:
        - app
        # Every module, src and tests alike. Written as the parent directory
        # rather than as `app-modules/*/src`: PHPStan does not expand globs in
        # `paths`, and naming each module would mean a module added tomorrow is
        # analysed only if somebody remembers to add a line here.
        - app-modules
        - config
        - routes
        - tests

    # Pest's own annotation, corrected. See the stub for why.
    stubFiles:
        - phpstan/TestCall.stub


    # There is deliberately no `ignoreErrors` section and no baseline file.
    # A baseline is how strictness quietly dies: it converts today's failures
    # into tomorrow's silence, and nobody ever reads it again. If the analyser
    # is wrong, teach it with a stub; if a `disallowed-calls` rule is wrong,
    # scope it with `allowIn` so the exception is named and greppable.
    #
    # `reportUnmatchedIgnoredErrors` is on so that if anyone ever does add an
    # ignore, it dies the moment the code beneath it is fixed.
    reportUnmatchedIgnoredErrors: true

    # An uninitialized typed property is a null that the type system promised
    # was impossible. In a persistent runtime it survives the screen that
    # forgot to set it.
    checkUninitializedProperties: true
    # `mixed` arriving implicitly is still `mixed`. Without this, level max
    # accepts an untyped array element flowing into a typed parameter.
    checkImplicitMixed: true
    # PHPStan's benevolent unions are how `array_key_first()` and friends
    # quietly hand you the type you did not handle.
    checkBenevolentUnionTypes: true
    # A method that declares more than it returns makes every caller write a
    # branch for a case that cannot happen — C2's problem, one layer down.
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    # A `@var` that widens what the analyser already knew is a lie in a
    # comment, and comments are not checked by anything else.
    reportAnyTypeWideningInVarTag: true

    # D3 — no `mixed` in a public signature, and nothing untyped anywhere.
    type_coverage:
        declare: 100
        return_type: 100
        param_type: 100
        property_type: 100
        constant_type: 100

    # H3 — caps on size, and F1 — components stay thin.
    #
    # SonarCloud's default gate is 15 per function; these sit below it on
    # purpose, so the failure arrives here rather than in a review comment. A
    # NativePHP component holds state and delegates decisions, which means a
    # component needing thirty branches is a presenter in disguise.
    cognitive_complexity:
        class: 30
        function: 8

    ergebnis:
        allRules: true
        noExtends:
            classesAllowedToBeExtended:
                - InvalidArgumentException
                - RuntimeException
                # The composition root is a Laravel service provider by
                # definition; there is no way to bind a port without being one.
                - Illuminate\Support\ServiceProvider
                # Likewise the base test case: booting the application is the
                # whole reason Tests\TestCase exists.
                - Illuminate\Foundation\Testing\TestCase
                # NativePHP components are extended by the framework's own
                # contract; a component that did not extend it is not a screen.
                - Native\Mobile\Edge\NativeComponent
        # A screen's state is what the renderer reads on re-render, so a
        # component's properties are mutable by construction. Every other class
        # in this application is readonly, and an architecture test says so
        # rather than leaving the exemption to this file alone.
        # A named argument at a call site is the only thing that tells a reader
        # which of four strings is the namespace. Refusing them makes a value
        # object's construction less readable, not safer.
        noNamedArgument:
            enabled: false
        noConstructorParameterWithDefaultValue:
            enabled: false
        noParameterWithNullDefaultValue:
            enabled: false
        # A nullable answer is the difference between "not read yet" and "read,
        # and there is nothing" — which is the distinction N1-R9 turns on.
        noParameterWithNullableTypeDeclaration:
            enabled: false
        noNullableReturnTypeDeclaration:
            enabled: false

    # -----------------------------------------------------------------------
    # ARCHITECTURE.md A2/A3/A4, B1-B4 and C3, enforced at the call site.
    #
    # `allowIn` paths are fnmatch patterns resolved against `filesRootDir`.
    # Every entry below carries a `message` naming the port to use instead:
    # the message is the whole rule as far as the next reader is concerned,
    # and "forbidden" without "use X" is a puzzle rather than an instruction.
    # -----------------------------------------------------------------------
    filesRootDir: %rootDir%/../../..

    disallowedFunctionCalls:
        # --- B1: time is an input, so it arrives through a port -------------
        -
            function:
                - 'now()'
                - 'time()'
                - 'date()'
                - 'mktime()'
                - 'microtime()'
                - 'hrtime()'
                - 'strtotime()'
            message: "B1 — time arrives through the Clock port. Time is a hidden input: the same call returns a different answer tomorrow, so no test can pin it. Inject Modules\\Kernel\\Api\\Clock and call $this->clock->now(). The one implementation that reads the device clock lives in app-modules/device/src (B1)."
            allowIn:
                - app-modules/device/src/*
                - tests/*

        # --- B2: randomness is an input too --------------------------------
        -
            function:
                - 'random_int()'
                - 'random_bytes()'
                - 'rand()'
                - 'mt_rand()'
                - 'srand()'
                - 'mt_srand()'
                - 'uniqid()'
            message: "B2 — randomness arrives through the Entropy port. Randomness is a hidden input. An idempotency key or a request id built from rand() cannot be asserted on, so the test asserts nothing. Inject Modules\\Kernel\\Api\\Entropy; its device-backed implementation lives in app-modules/device/src, and tests use the deterministic fake (B2)."
            allowIn:
                - app-modules/device/src/*
                - tests/*

        # --- B4: waiting is a port, not a syscall ---------------------------
        -
            function:
                - 'sleep()'
                - 'usleep()'
                - 'time_nanosleep()'
                - 'time_sleep_until()'
            message: "B4 — waiting is a port, not a syscall. Sleeping blocks the one process that draws the screen, and a test that sleeps is a test that is slow and still flaky. Express \"retry after thirty seconds\" as a value on an Outcome and let the surface schedule it (B4)."

        # --- B3: the filesystem belongs to two adapters ---------------------
        -
            function:
                - 'file_get_contents()'
                - 'file_put_contents()'
                - 'fopen()'
                - 'fwrite()'
                - 'fread()'
                - 'fclose()'
                - 'unlink()'
                - 'mkdir()'
                - 'rmdir()'
                - 'rename()'
                - 'copy()'
                - 'file_exists()'
                - 'is_file()'
                - 'scandir()'
                - 'glob()'
            message: "B3 — the filesystem belongs to an adapter. It is IO, and IO is an adapter's job. A capability that reads a file cannot be unit tested and cannot be reasoned about offline. Use Modules\\Kernel\\Api\\SecureStore (implemented in app-modules/vault/src, on Keychain or Keystore) for anything that must survive a restart, or the device adapter for anything platform-owned (B3, N4-R5)."
            allowIn:
                - app-modules/vault/src/*
                - app-modules/device/src/*
                - tests/*

        # --- A3/A4: service location hides what a class needs ---------------
        -
            function:
                - 'app()'
                - 'resolve()'
                - 'config()'
                - 'cache()'
                - 'auth()'
                - 'request()'
                - 'session()'
                - 'session_start()'
                - 'logger()'
                - 'report()'
                - 'abort()'
                - 'event()'
                - 'dispatch()'
            message: "A3/A4 — dependencies arrive through the constructor. Reaching into the container makes the constructor stop telling the truth about what this class needs, and a reader has to run the code to find out. Declare the dependency as a constructor parameter and bind it in app/Providers (A3, A4)."
            allowIn:
                - app/Providers/*
                - config/*
                - tests/*

    disallowedStaticCalls:
        # --- B1 ------------------------------------------------------------
        -
            method:
                - 'Carbon\Carbon::now()'
                - 'Carbon\CarbonImmutable::now()'
                - 'Illuminate\Support\Carbon::now()'
                - 'Carbon\Carbon::today()'
                - 'Carbon\CarbonImmutable::today()'
            message: "B1 — time arrives through the Clock port. Carbon::now() reads a global clock, and freezing it in a test changes global state that the next test inherits. Inject Modules\\Kernel\\Api\\Clock and hand a FrozenClock to the test instead (B1)."
            allowIn:
                - app-modules/device/src/*
                - tests/*

        # --- B2 ------------------------------------------------------------
        -
            method:
                - 'Illuminate\Support\Str::random()'
                - 'Illuminate\Support\Str::uuid()'
                - 'Illuminate\Support\Str::orderedUuid()'
                - 'Illuminate\Support\Str::ulid()'
                - 'Ramsey\Uuid\Uuid::uuid4()'
                - 'Ramsey\Uuid\Uuid::uuid7()'
                - 'Symfony\Component\Uid\Uuid::v4()'
            message: "B2 — randomness arrives through the Entropy port. An id generated inline cannot be asserted on, and an IdempotencyKey that changes on every call is not an idempotency key. Inject Modules\\Kernel\\Api\\Entropy (B2)."
            allowIn:
                - app-modules/device/src/*
                - tests/*

    disallowedNamespaces:
        # --- A2: facades are global state wearing a class name --------------
        -
            class: 'Illuminate\Support\Facades\*'
            # Storage has its own entry below: it is banned for being IO, in
            # two more places than a facade is banned for being a facade.
            exclude: 'Illuminate\Support\Facades\Storage'
            message: "A2 — no facades. A facade is a global lookup that no constructor mentions and no test can substitute without touching global state. Type the contract (Illuminate\\Contracts\\*) as a constructor parameter and bind it in app/Providers, or — inside a module — define a port in Modules\\Kernel\\Api and keep Illuminate out entirely (A2, A7)."
            allowIn:
                - app/Providers/*
                - config/*
                # routes/console.php is Artisan's own registration file: the
                # facade there IS the composition, not a reach into one.
                - routes/*
                - tests/*

        # --- B3: Storage is the filesystem with a nicer name ----------------
        -
            class: 'Illuminate\Support\Facades\Storage'
            message: "B3 — the filesystem belongs to an adapter. Storage writes to disk. Anything that must survive a restart on a phone belongs in the platform's secure storage via Modules\\Kernel\\Api\\SecureStore (app-modules/vault/src), never a file (N4-R5, B3)."
            allowIn:
                - app-modules/vault/src/*
                - app-modules/device/src/*
                - tests/*

        # --- A3: the container, named directly ------------------------------
        -
            class:
                - 'Illuminate\Container\*'
                - 'Illuminate\Contracts\Container\Container'
            message: "A3 — no service location. A class that reaches into the container hides what it needs. The composition root in app/Providers is the one place that is allowed to know how a port meets an adapter (A3)."
            allowIn:
                - app/Providers/*
                - tests/*

        # --- B1: the clock, as a type ---------------------------------------
        -
            class:
                - 'DateTime'
                - 'DateTimeImmutable'
            # A signature may still name the type; it is constructing one out of
            # the ambient clock that is the problem.
            allowInParamTypes: true
            allowInReturnType: true
            allowInUse: true
            message: "B1 — time arrives through the Clock port. Constructing a DateTimeImmutable with no argument reads the system clock, which is the hidden input B1 exists to remove. Take an Instant from Modules\\Kernel\\Api\\Clock; the device adapter is the only place allowed to build one from the platform (B1)."
            allowIn:
                - app-modules/device/src/*
                - tests/*

    disallowedMethodCalls:
        # --- C3: an exception that says nothing -----------------------------
        #
        # Matched on the constructor rather than on the class, so that naming
        # the type still works: a module-owned exception may extend one of
        # these, catch one, and name one in a signature. What it may not do is
        # throw one, which is the only part that reaches a caller.
        -
            method:
                - 'Exception::__construct()'
                - 'RuntimeException::__construct()'
                - 'LogicException::__construct()'
                - 'InvalidArgumentException::__construct()'
                - 'DomainException::__construct()'
                - 'UnexpectedValueException::__construct()'
                - 'ErrorException::__construct()'
            # Everywhere that is not a module. Written as an allow-list rather
            # than `allowExceptIn: [app-modules/*]` because `allowExceptIn`
            # short-circuits every directive evaluated after it.
            allowIn:
                - app/*
                - bootstrap/*
                - config/*
                - routes/*
                - tests/*
            # A module-owned exception constructing itself is the cure, not the
            # disease — and `new self(...)` inside a subclass of RuntimeException
            # resolves to the parent's constructor. Ordinary module code is not
            # a Throwable, so this widens nothing else.
            allowInInstanceOf:
                - 'Throwable'
            message: "C3 — every thrown exception is module-owned. A bare throw tells a catch block nothing it can act on, and a module boundary should be returning an Outcome rather than throwing at all (C1). Where a throw is genuinely right, name it: an exception class owned by the module says which module refused, and why (C3)."

services:
    # H5 — sprintf over concatenation. Written here rather than found in a
    # package because no published rule set carries it, and the rule is small
    # enough that owning it costs less than the alternative of not having it.
    -
        class: Lemonfiber\Companion\PHPStan\Rules\PreferSprintfOverConcatRule
        tags:
            - phpstan.rules.rule
