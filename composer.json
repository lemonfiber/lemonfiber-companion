{
    "name": "lemonfiber/companion",
    "description": "The lemonfiber companion app: a fourth surface, on a device that is not the machine the stack runs on.",
    "license": "LicenseRef-Hippocratic-3.0",
    "type": "project",
    "keywords": [
        "lemonfiber",
        "nativephp",
        "mobile",
        "self-hosted"
    ],
    "authors": [
        {
            "name": "NightWorks.io"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "internachi/modular": "^3.0",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "lemonfiber/bridge": "^0.1",
        "modules/backups": "dev-main",
        "modules/connection": "dev-main",
        "modules/design": "dev-main",
        "modules/device": "dev-main",
        "modules/health": "dev-main",
        "modules/household": "dev-main",
        "modules/kernel": "dev-main",
        "modules/operator": "dev-main",
        "modules/sdk": "dev-main",
        "modules/stacks": "dev-main",
        "modules/updates": "dev-main",
        "modules/vault": "dev-main",
        "nativephp/mobile": "^4.4",
        "nativephp/mobile-ui": "^0.4"
    },
    "require-dev": {
        "ext-simplexml": "*",
        "ext-tokenizer": "*",
        "ergebnis/composer-normalize": "^2.53",
        "ergebnis/phpstan-rules": "^2.13",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "modules/dx": "dev-main",
        "nikic/php-parser": "^5.8",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.6",
        "roave/security-advisories": "dev-latest",
        "saloonphp/saloon": "^4.0",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "shipmonk/phpstan-rules": "^4.4",
        "spaze/phpstan-disallowed-calls": "^4.14",
        "symfony/process": "^8.1",
        "tomasvotruba/cognitive-complexity": "^1.2",
        "tomasvotruba/type-coverage": "^2.3"
    },
    "repositories": [
        {
            "type": "path",
            "url": "bridge",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "nativephp",
            "type": "composer",
            "url": "https://plugins.nativephp.com"
        },
        {
            "type": "vcs",
            "url": "https://github.com/lemonfiber/sdk-php"
        },
        {
            "type": "path",
            "url": "app-modules/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\Providers\\": "bootstrap/Composition/NativePHP/Admitting/",
            "Bootstrap\\Composition\\": "bootstrap/Composition/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lemonfiber\\Companion\\PHPStan\\": "phpstan/",
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0"
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-install-cmd": [
            "git config core.hooksPath .githooks",
            "@php scripts/patch_nativephp.php",
            "@php scripts/patch_pest_mutate.php"
        ],
        "post-update-cmd": [
            "git config core.hooksPath .githooks",
            "@php scripts/patch_nativephp.php",
            "@php scripts/patch_pest_mutate.php"
        ],
        "analyse": "phpstan analyse",
        "ci": [
            "@composer validate --strict",
            "@validate:modules",
            "@composer normalize --dry-run",
            "@normalize:modules",
            "@composer audit",
            "@lint",
            "@analyse",
            "@refactor",
            "@deps",
            "@test:guards",
            "@test:report",
            "@test:floors",
            "@test:mutation"
        ],
        "deps": "composer-dependency-analyser",
        "lint": "pint --test",
        "lint:fix": "pint",
        "normalize:modules": "@php scripts/manifests.php normalize --dry-run",
        "normalize:modules:fix": "@php scripts/manifests.php normalize",
        "refactor": "rector process --dry-run",
        "refactor:fix": "rector process",
        "test": "pest --parallel --exclude-testsuite=Guards,Floors",
        "test:coverage": "php -d pcov.directory=. -d pcov.exclude='~/(vendor|bootstrap/cache)/~' vendor/bin/pest --exclude-testsuite=Guards,Floors --coverage --min=100",
        "test:floors": "pest --testsuite=Floors",
        "test:guards": "pest --testsuite=Guards",
        "test:mutation": "@php scripts/mutation.php",
        "test:report": "php -d pcov.directory=. -d pcov.exclude='~/(vendor|bootstrap/cache)/~' vendor/bin/pest --exclude-testsuite=Guards,Floors --coverage --coverage-clover=coverage/clover.xml --log-junit=coverage/junit.xml --min=100",
        "validate:modules": "@php scripts/manifests.php validate --strict --no-check-publish"
    },
    "scripts-descriptions": {
        "ci": "Every PHP gate CI runs, in the order it runs them, and only those. It does not run the native halves \u2014 the Kotlin and Swift harnesses and the check that both ask the same questions \u2014 nor CodeQL, SonarCloud, the security and supply-chain scans, the repository hygiene checks, or the commit, spec-reference and SDK-pin gates. Those need a toolchain, a network or a pull request that a local run has not got.",
        "normalize:modules": "Check every module manifest against the normalizer; the root normalize does not look at them.",
        "normalize:modules:fix": "Normalize every module manifest in place.",
        "test": "Every suite but Guards and Floors, in parallel. Guards plants a violation of every rule into the working tree, so a process reading that tree beside it sees files appear and vanish. Floors reads the clover report test:report writes, and refuses to run without one.",
        "test:floors": "Check every module against the coverage floor it declared, over the report test:report writes (G9).",
        "test:guards": "Plant a violation of every rule and require each rule to report it (R2).",
        "test:mutation": "Mutation testing at the floor each module declares. Modules sharing a floor share a run, because a floor of 100 admits no offsetting between them; a module whose floor differs gets its own.",
        "test:report": "The same run as test:coverage, writing the clover and JUnit reports SonarCloud and the Floors suite read (Q-R64, G9). The pcov flags are load-bearing: left alone, pcov instruments the longest common prefix of the phpunit source includes, which is `app` \u2014 and that reaches `app-modules` only because the match is on the string rather than the path. `bridge/src` falls outside it, so every line of the plugin's PHP read as never executed while its tests passed. Pointing the directory at the repository root fixes that, and excluding vendor makes the run faster than it was before.",
        "validate:modules": "Validate every module manifest; the root validate does not look at them."
    }
}
