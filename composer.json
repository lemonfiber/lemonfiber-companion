{
    "name": "lemonfiber/companion",
    "description": "The lemonfiber companion app: a fourth surface, on a device that is not the machine the stack runs on.",
    "license": "LicenseRef-Hippocratic-3.0",
    "type": "project",
    "keywords": [
        "lemonfiber",
        "nativephp",
        "mobile",
        "self-hosted"
    ],
    "authors": [
        {
            "name": "NightWorks.io"
        }
    ],
    "require": {
        "php": "^8.5",
        "internachi/modular": "^3.0",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "modules/backups": "dev-main",
        "modules/connection": "dev-main",
        "modules/design": "dev-main",
        "modules/device": "dev-main",
        "modules/health": "dev-main",
        "modules/household": "dev-main",
        "modules/kernel": "dev-main",
        "modules/operator": "dev-main",
        "modules/sdk": "dev-main",
        "modules/stacks": "dev-main",
        "modules/updates": "dev-main",
        "modules/vault": "dev-main",
        "nativephp/mobile": "^4.4"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "captainhook/captainhook": "^5.29",
        "ergebnis/composer-normalize": "^2.53",
        "ergebnis/phpstan-rules": "^2.13",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.12",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.6",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "shipmonk/phpstan-rules": "^4.4",
        "spaze/phpstan-disallowed-calls": "^4.14",
        "tomasvotruba/cognitive-complexity": "^1.2",
        "tomasvotruba/type-coverage": "^2.3"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/lemonfiber/sdk-php"
        },
        {
            "type": "path",
            "url": "app-modules/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "tests/Support/rules.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0"
        },
        "sort-packages": true
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": true
        },
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-install-cmd": [
            "git config core.hooksPath .githooks"
        ],
        "post-update-cmd": [
            "git config core.hooksPath .githooks"
        ],
        "analyse": "phpstan analyse",
        "ci": [
            "@composer validate --strict",
            "@validate:modules",
            "@composer normalize --dry-run",
            "@composer audit",
            "@lint",
            "@analyse",
            "@refactor",
            "@deps",
            "@test:coverage",
            "@test:mutation"
        ],
        "deps": "composer-dependency-analyser",
        "lint": "pint --test",
        "lint:fix": "pint",
        "refactor": "rector process --dry-run",
        "refactor:fix": "rector process",
        "test": "pest",
        "test:coverage": "pest --coverage --min=100",
        "test:mutation": "pest --mutate --covered-only --min=100 --ignore-min-score-on-zero-mutations --path=app-modules/connection/src,app-modules/stacks/src,app-modules/health/src,app-modules/backups/src,app-modules/updates/src,app-modules/operator/src/Internal/Presenters,app-modules/household/src/Internal/Presenters",
        "validate:modules": "@php -r \"\\$bad=0; foreach (glob('app-modules/*/composer.json') as \\$m) { passthru('composer validate --strict --no-check-publish '.escapeshellarg(\\$m), \\$c); \\$bad = \\$bad ?: \\$c; } exit(\\$bad === 0 ? 0 : 1);\""
    },
    "scripts-descriptions": {
        "ci": "Every gate CI runs, in the order it runs them.",
        "test:mutation": "Mutation testing over the five capability modules and the two presenter directories — every place a decision is made. Components, adapters and views hold no logic to mutate, so mutating them would measure the fakes rather than the app.",
        "validate:modules": "Validate every module manifest; the root validate does not look at them."
    }
}
